{
  "mcpServers": {
    "echo": {
      "command": "node",
      "args": ["./mcp-echo.mjs"]
    },
    "remote-example": {
      "type": "http",
      "url": "${REMOTE_MCP_URL:-https://example.invalid/mcp}",
      "headers": { "Authorization": "Bearer ${REMOTE_MCP_TOKEN:-unset}" }
    },
    "missing-var-example": {
      "command": "node",
      "args": ["./mcp-echo.mjs", "--token", "${ROSETTA_MISSING_VAR}"]
    }
  }
}
